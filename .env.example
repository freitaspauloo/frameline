# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Phase 2 commerce) — unlocks Prisma client
DATABASE_URL=postgresql://user:password@localhost:5432/frameline

# Admin (comma-separated). Demo also accepts admin@frameline.ai or ?demo=1
FRAMELINE_ADMIN_EMAILS=you@studio.dev

# Stripe (guest checkout) — without these, /api/checkout runs in demo mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Auth provider (pick one later — scaffold is provider-agnostic)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Email (receipts / magic link)
# RESEND_API_KEY=
# EMAIL_FROM=Frameline <orders@frameline.ai>
