# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Phase 2 commerce) — unlocks Prisma client
DATABASE_URL=postgresql://user:password@localhost:5432/frameline

# Admin (comma-separated). Demo also accepts admin@frameline.ai or ?demo=1
FRAMELINE_ADMIN_EMAILS=you@studio.dev

# Stripe (guest checkout) — without these, /api/checkout runs in demo mode
# and fulfills into .data/orders.json + .data/entitlements.json
STRIPE_SECRET_KEY=
# Webhook demo mode: leave STRIPE_WEBHOOK_SECRET empty so
# POST /api/webhooks/stripe accepts JSON
#   { "type": "checkout.session.completed", "email", "plan", "material?" }
# and runs the same demo fulfillment (idempotent when paymentProviderRef/id set).
# If STRIPE_WEBHOOK_SECRET is set, the route returns 501 until signature verify is wired.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase Admin (server) — from service account JSON
# Prefer GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-adminsdk.json
# or set these three:
FIREBASE_PROJECT_ID=frameline-b89ac
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@frameline-b89ac.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-adminsdk.json

# Firebase Web client (browser) — Firebase Console → Project settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=frameline-b89ac.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=frameline-b89ac
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=frameline-b89ac.appspot.com

# Optional alternate auth
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Email (receipts / magic link)
# RESEND_API_KEY=
# EMAIL_FROM=Frameline <orders@frameline.ai>

# Analytics — optional Plausible; no-op unless set (see src/components/analytics.tsx)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=frameline.ai

# Monitoring — optional Sentry DSN; captureException/captureMessage are stubs
# until @sentry packages are wired (see src/lib/monitoring.ts)
# SENTRY_DSN=
